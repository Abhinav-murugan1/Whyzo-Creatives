# Cloudflare R2 Credentials (for media storage & upload)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-bucket-name
R2_PUBLIC_URL=https://pub-2f10f2730a564fb78e256c70fd23585d.r2.dev

# Cloudinary credentials (legacy)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Optional: overrides the canonical/OG base URL used by src/utils/seo.js
# VITE_SITE_URL=https://whyzocreatives.com

# EmailJS - powers the contact form. All three are public by design (the SDK runs in the browser and
# the values ship in the bundle), so they are safe to commit. Security comes from the domain
# allowlist under EmailJS > Account > Security, not from hiding these.
# Only set these to override the defaults baked into src/components/ContactSection.jsx.
# VITE_EMAILJS_SERVICE_ID=service_gjk9ayn
# VITE_EMAILJS_TEMPLATE_ID=template_k3u9l8j
# VITE_EMAILJS_PUBLIC_KEY=your-public-key
